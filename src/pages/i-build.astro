---
import BaseLayout from '../layouts/BaseLayout.astro';
import portfolioData from '../data/portfolioData';

const projects = portfolioData.projects;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "I like to build software — Jan Medina",
  "description": "Things I've built. Each one started from a real problem I felt and became something I shipped.",
  "url": "https://janbmedina.com/i-build"
};
---

<BaseLayout
  title="I like to build software — Jan Medina"
  description="Five things I built because I needed them. Real problems, real code, real users."
  canonicalPath="/i-build"
  jsonLd={jsonLd}
>
  <div class="max-w-5xl mx-auto px-6 py-16">
    <!-- Header -->
    <div class="mb-12">
      <a href="/projects" class="text-sm font-mono uppercase tracking-[0.18em] text-neutral-500 hover:text-black transition-colors">← Back to projects</a>
      
      <h1 class="mt-6 font-heading text-6xl md:text-7xl font-black tracking-[-0.02em] leading-none">
        I like to build software
      </h1>
      <p class="mt-4 max-w-2xl text-xl text-neutral-600">
        Turning real problems in IT and daily life into things that actually ship.
      </p>
    </div>

    <!-- Gallery -->
    <div class="grid gap-10 md:gap-12">
      {projects.map((project, index) => {
        const num = String(index + 1).padStart(2, '0');
        const imageSrc = `/images/projects/${project.id}-hero.jpg`;
        const primaryLink = project.links?.[0] || (project.id === 'neobrutalist-os' ? { label: 'Enter the OS', url: '/os' } : null);
        
        return (
          <article class="group">
            <div class="flex items-baseline gap-4 mb-3">
              <span class="font-mono text-sm uppercase tracking-[0.2em] text-neutral-400">{num}</span>
              <h2 class="font-heading text-4xl font-black tracking-[-0.01em]">{project.name}</h2>
              {project.status === 'in-progress' && (
                <span class="ml-2 text-xs font-semibold uppercase px-3 py-1 rounded border border-yellow/60 bg-yellow/10 text-yellow-700">In progress</span>
              )}
            </div>

            <!-- Hero image -->
            <div class="relative mb-6 overflow-hidden border-[3px] border-black bg-neutral-100">
              <img 
                src={imageSrc} 
                alt={`Screenshot of ${project.name}`}
                class="w-full h-auto object-cover"
                width="1600"
                height="900"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </div>

            <div class="max-w-3xl">
              <p class="text-[17px] leading-tight text-neutral-800">
                {project.oneSentence}
              </p>

              {project.techStack && project.techStack.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {project.techStack.map((tech) => (
                    <span class="px-3 py-1 text-xs font-mono uppercase tracking-[0.1em] border border-black/30 bg-white text-neutral-700">
                      {tech}
                    </span>
                  ))}
                </div>
              )}

              {primaryLink && (
                <a 
                  href={primaryLink.url}
                  target={primaryLink.url.startsWith('http') ? '_blank' : undefined}
                  rel={primaryLink.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="inline-flex items-center gap-2 mt-6 text-sm font-bold uppercase tracking-[0.12em] text-green-700 hover:text-green-900 transition-colors"
                >
                  {primaryLink.label} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-16 pt-8 border-t border-black/10 text-sm text-neutral-500 max-w-2xl">
      Every project above started because I hit a wall in my own work or life. I kept building until the wall was gone.
    </div>
  </div>
</BaseLayout>
