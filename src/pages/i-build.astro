---
import BaseLayout from '../layouts/BaseLayout.astro';
import portfolioData from '../data/portfolioData';
import type { ProjectDetail } from '../data/portfolioData';

interface ShowcaseImage {
  src: string;
  width: number;
  height: number;
  orientation: 'landscape' | 'portrait';
  alt: string;
}

interface ShowcaseProject {
  project: ProjectDetail;
  image: ShowcaseImage;
  description: string;
  techStack: string[];
  primaryLink: { label: string; url: string } | null;
  fallbackNote: string;
  articleClass: string;
  mediaClass: string;
  contentClass: string;
}

const showcaseImages: Record<string, ShowcaseImage> = {
  'neobrutalist-os': {
    src: '/images/projects/neobrutalist-os-hero.jpg',
    width: 1408,
    height: 768,
    orientation: 'landscape',
    alt: 'Generated screenshot-style visual for the neobrutalist-os retro desktop',
  },
  move45: {
    src: '/images/projects/move45-hero.jpg',
    width: 896,
    height: 1280,
    orientation: 'portrait',
    alt: 'Generated screenshot-style visual for the move45 iOS app',
  },
  iwt: {
    src: '/images/projects/iwt-hero.jpg',
    width: 896,
    height: 1280,
    orientation: 'portrait',
    alt: 'Generated screenshot-style visual for the iwt interval walking trainer',
  },
  'lifespan-tracker': {
    src: '/images/projects/lifespan-tracker-hero.jpg',
    width: 1408,
    height: 768,
    orientation: 'landscape',
    alt: 'Generated screenshot-style visual for the lifespan-tracker dashboard',
  },
  covercraft: {
    src: '/images/projects/covercraft-hero.jpg',
    width: 1408,
    height: 768,
    orientation: 'landscape',
    alt: 'Generated screenshot-style visual for the covercraft web app',
  },
};

const cardLayouts = [
  {
    articleClass: 'lg:col-span-6 lg:grid lg:grid-cols-[minmax(0,1.18fr)_minmax(22rem,0.82fr)]',
    mediaClass: 'aspect-[16/9] lg:aspect-auto lg:min-h-[30rem]',
    contentClass: 'lg:border-l-[3px] lg:border-t-0 lg:flex lg:flex-col lg:justify-between',
  },
  {
    articleClass: 'lg:col-span-3',
    mediaClass: 'aspect-[4/3]',
    contentClass: '',
  },
  {
    articleClass: 'lg:col-span-3',
    mediaClass: 'aspect-[4/3]',
    contentClass: '',
  },
  {
    articleClass: 'lg:col-span-4',
    mediaClass: 'aspect-[16/9]',
    contentClass: '',
  },
  {
    articleClass: 'lg:col-span-2',
    mediaClass: 'aspect-[4/3] lg:aspect-[5/4]',
    contentClass: '',
  },
] as const;

const getPrimaryLink = (project: ProjectDetail) => {
  if (project.id === 'neobrutalist-os') {
    return { label: 'Open OS', url: '/os' };
  }

  return project.links?.[0] ?? null;
};

const newFocusedProjects = [
  {
    id: '45min-timer',
    name: '45 Min iOS Square Reminder Timer',
    oneSentence: 'A focused iOS timer app that uses square visual reminders for precise 45-minute work or walk sessions with notifications.',
    techStack: ['Swift', 'SwiftUI', 'iOS'],
    primaryLink: { label: 'App Store', url: '#' },
    image: {
      src: '/images/projects/45min-timer-hero.jpg',
      width: 896,
      height: 1280,
      orientation: 'portrait' as const,
      alt: 'iPhone mockup of the 45 Min Square Reminder Timer iOS app',
    },
  },
  {
    id: 'iwt',
    name: 'IWT Japanese Walking App',
    oneSentence: 'An iOS app for Japanese-style interval walking training with guided pace changes, timers, and session logging.',
    techStack: ['Swift', 'SwiftUI', 'iOS'],
    primaryLink: { label: 'App Store', url: '#' },
    image: {
      src: '/images/projects/iwt-hero.jpg',
      width: 896,
      height: 1280,
      orientation: 'portrait' as const,
      alt: 'iPhone showing the IWT Japanese Walking App interface',
    },
  },
  {
    id: 'label-peek',
    name: 'Label Peek',
    oneSentence: 'A lightweight tool that lets you quickly peek and manage labels across tasks, notes, and projects without leaving your flow.',
    techStack: ['Swift', 'SwiftUI', 'macOS', 'iOS'],
    primaryLink: { label: 'Download', url: '#' },
    image: {
      src: '/images/projects/label-peek-hero.jpg',
      width: 1408,
      height: 768,
      orientation: 'landscape' as const,
      alt: 'Screenshot of Label Peek tool interface',
    },
  },
  {
    id: 'leanstack-protocol',
    name: 'LeanStack Protocol',
    oneSentence: 'A minimal protocol and set of tools for building lean, composable application stacks with clear boundaries and low overhead.',
    techStack: ['TypeScript', 'Node.js', 'Protocol'],
    primaryLink: { label: 'Documentation', url: '#' },
    image: {
      src: '/images/projects/lifespan-tracker-hero.jpg',
      width: 1408,
      height: 768,
      orientation: 'landscape' as const,
      alt: 'LeanStack Protocol architecture diagram and code example',
    },
  },
  {
    id: 'listenonce',
    name: 'ListenOnce iOS App',
    oneSentence: 'An iOS app designed for one-time focused listening sessions with progress tracking, offline support, and minimal distractions.',
    techStack: ['Swift', 'SwiftUI', 'iOS'],
    primaryLink: { label: 'App Store', url: '#' },
    image: {
      src: '/images/projects/move45-hero.jpg',
      width: 896,
      height: 1280,
      orientation: 'portrait' as const,
      alt: 'iPhone mockup of the ListenOnce iOS app',
    },
  },
];

const showcaseProjects = newFocusedProjects;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "I like to build software - Jan Medina",
  "description": "Five focused projects with custom visuals and one-sentence descriptions. Turning problems into shipped software.",
  "url": "https://janbmedina.com/i-build"
};
---

<BaseLayout
  title="I like to build software - Jan Medina"
  description="Five projects with custom visuals and one-sentence descriptions. Turning problems into shipped software."
  canonicalPath="/i-build"
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
    <nav aria-label="Breadcrumb" class="mb-10">
      <ol class="flex items-center gap-2 text-sm text-neutral-500">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/projects" class="hover:underline">Projects</a></li>
        <li aria-hidden="true">/</li>
        <li class="font-semibold text-black">I build</li>
      </ol>
    </nav>

    <header class="mb-12 lg:mb-16 grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
      <div>
        <a href="/projects" class="inline-flex items-center gap-2 font-mono text-sm font-bold text-green hover:text-black transition-colors">
          <span aria-hidden="true">&larr;</span>
          Back to projects
        </a>
        <h1 class="mt-7 max-w-4xl font-heading text-[clamp(2.5rem,6vw,4rem)] font-black leading-none tracking-tight">
          I like to build software
        </h1>
        <p class="mt-5 max-w-2xl text-lg sm:text-xl leading-relaxed text-neutral-700">
          Five real projects shaped by IT work, daily habits, and the itch to ship useful tools.
        </p>
      </div>

      <aside class="neo-border bg-green/20 p-5 shadow-neo-sm">
        <p class="font-mono text-sm font-bold text-neutral-700">showcase / 05</p>
        <p class="mt-3 text-sm leading-relaxed text-neutral-700">
          A cleaner visual shelf for the same builds hiding inside the retro OS.
        </p>
      </aside>
    </header>

    <section class="space-y-10" aria-label="Project showcase">
      {showcaseProjects.map((proj, index) => {
        const num = String(index + 1).padStart(2, '0');
        const isPortrait = proj.image.orientation === 'portrait';

        return (
          <article class="grid gap-6 md:grid-cols-12 md:items-center border-t border-black/10 pt-8 first:border-t-0 first:pt-0">
            <div class="md:col-span-5">
              <div class="font-mono text-xs font-bold text-neutral-500 mb-2">{num}</div>
              <div class="overflow-hidden neo-border shadow-neo bg-white">
                <img
                  src={proj.image.src}
                  alt={proj.image.alt}
                  width={proj.image.width}
                  height={proj.image.height}
                  class={`w-full h-auto object-cover ${isPortrait ? 'aspect-[4/5] object-contain bg-cream p-4' : 'aspect-video'}`}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
            </div>

            <div class="md:col-span-7">
              <h2 class="font-heading text-3xl sm:text-4xl font-black tracking-tight">
                {proj.name}
              </h2>

              <p class="mt-4 text-lg leading-snug text-neutral-700 max-w-prose">
                {proj.oneSentence}
              </p>

              <div class="mt-5 flex flex-wrap gap-2">
                {proj.techStack.map((tech) => (
                  <span class="inline-block border border-black/15 bg-white px-3 py-1 text-xs font-medium tracking-[0.06em] text-neutral-600">
                    {tech}
                  </span>
                ))}
              </div>

              {proj.primaryLink && (
                <div class="mt-6">
                  <a
                    href={proj.primaryLink.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-sm font-bold text-green hover:underline"
                  >
                    {proj.primaryLink.label} <span aria-hidden="true">→</span>
                  </a>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </section>

    <div class="mt-14 border-t-[3px] border-black pt-6 text-sm leading-relaxed text-neutral-600 sm:max-w-2xl">
      Every project started because I hit a real wall in my own work or life. I kept building until the wall was gone.
    </div>
  </div>
</BaseLayout>
