---
import BaseLayout from '../layouts/BaseLayout.astro';
import portfolioData from '../data/portfolioData';

// Focused projects only (removed iwt and covercraft per latest direction, matching the visual density and focus of the provided inspiration screenshots)
const focusedProjectIds = ['neobrutalist-os', 'move45', 'lifespan-tracker'];
const projects = portfolioData.projects.filter(p => focusedProjectIds.includes(p.id));

// Taste-skill guided dials for this editorial portfolio gallery on neobrutalist cream site:
// VARIANCE 6 (measured asymmetry within thick borders), MOTION 3 (subtle lifts only), DENSITY 4 (breathing room)

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "I like to build software — Jan Medina",
  "description": "Three focused projects with custom visuals and one-sentence descriptions. Turning problems into shipped software.",
  "url": "https://janbmedina.com/i-build"
};
---

<BaseLayout
  title="I like to build software — Jan Medina"
  description="Three focused projects with custom visuals and one-sentence descriptions. Turning problems into shipped software."
  canonicalPath="/i-build"
  jsonLd={jsonLd}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-sm text-neutral-500">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/projects" class="hover:underline">Projects</a></li>
        <li aria-hidden="true">/</li>
        <li class="font-semibold text-black">I like to build software</li>
      </ol>
    </nav>

    <div class="max-w-3xl">
      <div class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-500 mb-2">Projects</div>
      <h1 class="font-heading text-5xl sm:text-6xl font-black tracking-tighter">I like to build software</h1>
      <p class="mt-4 text-xl text-neutral-600 max-w-[42ch]">
        Turning real problems into shipped work. Three focused projects, one sentence each.
      </p>
    </div>

    <div class="mt-12 grid gap-8 md:gap-10">
      {projects.map((project, index) => {
        const num = String(index + 1).padStart(2, '0');
        const imageSlug = project.id;
        const imagePath = `/images/projects/${imageSlug}-hero.jpg`;
        const sentence = project.oneSentence || project.summary;
        const stack = project.techStack || [];

        return (
          <article class="group grid gap-6 md:grid-cols-12 md:items-center border-t border-black/10 pt-8 first:border-t-0 first:pt-0">
            <!-- Number + Image -->
            <div class="md:col-span-5">
              <div class="flex items-center gap-3 mb-3">
                <span class="font-mono text-sm font-bold text-neutral-400">{num}</span>
                {project.status === 'in-progress' && (
                  <span class="text-[10px] font-semibold uppercase tracking-[0.12em] px-2.5 py-0.5 rounded-full bg-yellow/15 text-yellow border border-yellow/30">
                    In progress
                  </span>
                )}
              </div>

              <div class="overflow-hidden neo-border shadow-neo bg-white">
                <img
                  src={imagePath}
                  alt={`Hero image for ${project.name}`}
                  width="1200"
                  height="675"
                  class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-[1.015]"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
            </div>

            <!-- Content -->
            <div class="md:col-span-7">
              <h2 class="font-heading text-3xl sm:text-4xl font-black tracking-[-0.02em]">
                {project.name}
              </h2>

              <p class="mt-4 text-lg leading-snug text-neutral-700 max-w-[52ch]">
                {sentence}
              </p>

              {stack.length > 0 && (
                <div class="mt-5 flex flex-wrap gap-2">
                  {stack.map((tech) => (
                    <span class="inline-block border border-black/15 bg-white px-3 py-1 text-xs font-medium tracking-[0.06em] text-neutral-600">
                      {tech}
                    </span>
                  ))}
                </div>
              )}

              {project.links && project.links.length > 0 && (
                <div class="mt-6">
                  {project.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm font-bold text-green hover:underline"
                    >
                      {link.label} <span aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              )}

              {project.cta && (
                <p class="mt-4 text-sm italic text-neutral-500">{project.cta}</p>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-16 border-t border-black/10 pt-8 text-sm text-neutral-500">
      Focused selection of projects built to solve real problems I actually had.
    </div>
  </div>
</BaseLayout>
